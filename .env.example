# PHP API server-side settings. Store this file outside the public web root.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_NAME=SpeakUp Administrator
ADMIN_PASSWORD=replace_with_a_long_unique_password
APP_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
APP_DEBUG=0

# Data stays inside the API deployment, not the frontend public directory.
# Defaults are api/db/data.db and api/uploads/ under the API directory.
# DATA_DB_PATH=/absolute/path/to/learnenglish/api/db/data.db
# UPLOADS_DIR=/absolute/path/to/learnenglish/api/uploads

# Comma-separated exact origins. Include only origins that host this frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://rikisample.test,https://rikikurnia.my.id
# For a genuinely cross-origin HTTPS frontend/API pairing use None; Secure is enforced.
SESSION_SAMESITE=Lax

# Optional server-side provider defaults. Admin UI may override and encrypt values in SQLite.
CLARIO_BASE_URL=https://clariohub.id/v1
CLARIO_FALLBACK_BASE_URL=https://api-direct.clariohub.id/v1
CLARIO_MODEL=clario/gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
