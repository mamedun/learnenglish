Options -Indexes
<FilesMatch "^(config(\.example)?|bootstrap|catalog|auth|router|tts_cache)\.php$">
  Require all denied
</FilesMatch>
RewriteEngine On
# Preserve Bearer headers for PHP-FPM/CGI when Apache handles the request.
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
