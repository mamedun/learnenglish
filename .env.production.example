# Frontend/Vite build only. Copy to .env.production.local if customising.
# Frontend mount path: /learnenglish, /speakup, or / for the domain root.
VITE_BASE_PATH=/learnenglish
# Same-origin API URL is derived automatically: <VITE_BASE_PATH>/api.
# Uncomment ONLY when the API is hosted on a different origin over HTTPS:
# VITE_API_BASE_URL=https://api.example.com/learnenglish/api
# Never put private PHP configuration, provider keys or passwords in VITE_*.
