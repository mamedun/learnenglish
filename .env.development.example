# Frontend/Vite only. Copy to .env.development.local and adjust if needed.
# Browser requests /learnenglish/api/*; Vite proxies those requests to PHP.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_API_PROXY_PATH_PREFIX=
# If PHP is at https://rikisample.test/learnenglish/api, instead use:
# VITE_API_PROXY_TARGET=https://rikisample.test
# VITE_API_PROXY_PATH_PREFIX=/learnenglish
# Do not set VITE_API_BASE_URL for a same-origin Vite proxy.
