# Vite proxies /learnenglish/api/* through PHP; browser remains same-origin.
VITE_API_PROXY_TARGET=https://rikisample.test
VITE_API_PROXY_PATH_PREFIX=/learnenglish
# Leave VITE_API_BASE_URL unset to use the Vite proxy. For truly cross-origin API only:
# VITE_API_BASE_URL=https://rikikurnia.my.id/learnenglish/api
