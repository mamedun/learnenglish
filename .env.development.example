# Frontend/Vite only. Copy to .env.development.local and adjust if needed.
# Where the frontend is mounted: /learnenglish, /speakup, or / for domain root.
VITE_BASE_PATH=/learnenglish

# Vite proxies browser requests to the PHP API during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
# Public path prefix where the PHP API is mounted; use an empty value for root.
VITE_API_PROXY_PATH_PREFIX=/learnenglish
# For a separate HTTPS API origin only, set VITE_API_BASE_URL instead of proxying.
# VITE_API_BASE_URL=https://api.example.com/learnenglish/api
# Never put private PHP configuration, provider keys or passwords in VITE_*.
